wf := import("@platforma-sdk/workflow-tengo:workflow")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")

gpuInfoSw := assets.importSoftware("@platforma-open/milaboratories.gpu-test.gpu-info:main")

wf.body(func(args) {
	b := exec.builder().
		software(gpuInfoSw)

	// Direct resource request via the new .resources({ onCPU, onGPU }) API.
	// The user types explicit cpu / mem / gpuMemory in the UI. When gpuMemory is
	// set we pass both onCPU and onGPU: the SDK reads exec.hasGpu at render time
	// and takes the onGPU allocation on a GPU-capable backend, the onCPU one
	// otherwise (adaptive). This lets the detection block still run on a CPU-only
	// backend instead of failing fast.
	cpu := (args.cpu != undefined && args.cpu != "") ? int(args.cpu) : 1
	ram := (args.mem != undefined && args.mem != "") ? args.mem : "1GiB"
	useGPU := args.gpuMemory != undefined && args.gpuMemory != ""

	if useGPU {
		b = b.resources({
			onCPU: { cpu: cpu, ram: ram },
			onGPU: { cpu: cpu, ram: ram, vram: args.gpuMemory }
		})
	} else {
		b = b.resources({
			onCPU: { cpu: cpu, ram: ram }
		})
	}

	b = b.arg("--seed").arg(string(args.seed))
	if args.matrixSize != undefined && args.matrixSize != "" {
		b = b.arg("--matrix-size").arg(string(args.matrixSize))
	}

	b = b.
		saveFileContent("gpu-info.json").
		saveStdoutStream()

	// GPU -> CPU fallback: when the backend reports that no GPU came in time (GPUMissed), the
	// same command runs again with the CPU allocation only. The copy is taken after every output
	// is declared, so the fallback saves and streams exactly what the GPU plan does.
	if useGPU {
		cpuOnly := b.copy().resources({
			onCPU: { cpu: cpu, ram: ram }
		})
		b = b.fallbacks({
			GPUMissed: [{ name: "cpuOnly", builder: cpuOnly }]
		})
	}

	gpuInfo := b.run()

	return {
		outputs: {
			gpuLog: gpuInfo.getStdoutStream(),
			gpuInfo: gpuInfo.getFileContent("gpu-info.json"),
			seed: args.seed
		},
		exports: {}
	}
})
